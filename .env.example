# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#     cp .env.example .env
#     set -a && source .env && set +a

# Snowflake account identifier, e.g. abcd-xy12345 (from your Snowsight URL)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# These match the objects created by snowflake_scripts/01_setup.sql.
# Defaults are baked into zomato/profiles.yml, so they only need setting to override.
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO

# AWS values used by the Phase 2 setup scripts (substituted into the SQL/JSON placeholders)
AWS_ACCOUNT_ID=
S3_BUCKET=
